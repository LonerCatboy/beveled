#
# Settings applied by the Beveled global theme. Icons and cursors stay Breeze for now.
# The wallpaper is a package from wallpapers/ in this repository.

[kdeglobals][KDE]
widgetStyle=Beveled

[kdeglobals][General]
ColorScheme=BeveledClassic

[kdeglobals][Icons]
Theme=breeze

[Wallpaper]
Image=beveled-synevyr

[plasmarc][Theme]
name=beveled

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kwinrc][org.kde.kdecoration2]
library=beveled

[ksplashrc][KSplash]
Engine=KSplashQML
Theme=beveled.desktop
