#
# Settings applied by the Beveled Dark global theme. Icons and cursors stay Breeze for now.

[kdeglobals][KDE]
widgetStyle=Beveled

[kdeglobals][General]
ColorScheme=BeveledDark

[kdeglobals][Icons]
Theme=breeze

[plasmarc][Theme]
name=beveled-dark

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kwinrc][org.kde.kdecoration2]
library=beveled

[ksplashrc][KSplash]
Engine=KSplashQML
Theme=beveled-dark.desktop
