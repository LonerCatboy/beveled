# Removes everything "cmake --install" ever installed from this build directory:
#   sudo cmake -P <build dir>/uninstall.cmake
# Every file listed in install_manifest.txt (last install) or installed_files.txt (earlier
# installs, see record-install.cmake) is deleted; then the directories that held them are removed
# if they are left empty and belong to Beveled (their name contains "beveled"), so shared system
# directories are never touched.

set(manifest "@CMAKE_BINARY_DIR@/install_manifest.txt")
set(history "@CMAKE_BINARY_DIR@/installed_files.txt")

set(files "")
foreach(list IN ITEMS "${manifest}" "${history}")
    if(EXISTS "${list}")
        file(STRINGS "${list}" entries)
        list(APPEND files ${entries})
    endif()
endforeach()
if(NOT files)
    message(FATAL_ERROR "Nothing to uninstall: no install was recorded in @CMAKE_BINARY_DIR@")
endif()
list(REMOVE_DUPLICATES files)

set(directories "")
foreach(file IN LISTS files)
    set(path "$ENV{DESTDIR}${file}")
    if(IS_SYMLINK "${path}" OR EXISTS "${path}")
        message(STATUS "Removing ${path}")
        file(REMOVE "${path}")
        if(IS_SYMLINK "${path}" OR EXISTS "${path}")
            message(FATAL_ERROR "Could not remove ${path} (run with sudo?)")
        endif()
    endif()
    # If the file sits inside a directory named after Beveled (a theme package), collect every
    # directory from the file up to that one. Files in shared directories collect nothing.
    # Names are checked on the installed path only, never on a DESTDIR staging prefix.
    get_filename_component(dir "${file}" DIRECTORY)
    set(chain "")
    while(NOT dir STREQUAL "/" AND NOT dir STREQUAL "")
        list(APPEND chain "$ENV{DESTDIR}${dir}")
        get_filename_component(name "${dir}" NAME)
        if(name MATCHES "beveled")
            list(APPEND directories ${chain})
            break()
        endif()
        get_filename_component(dir "${dir}" DIRECTORY)
    endwhile()
endforeach()

# Deepest directories first, so that parents are empty by the time they are checked.
list(REMOVE_DUPLICATES directories)
list(SORT directories ORDER DESCENDING)
foreach(dir IN LISTS directories)
    file(GLOB entries "${dir}/*" "${dir}/.*")
    if(IS_DIRECTORY "${dir}" AND NOT entries)
        message(STATUS "Removing empty directory ${dir}")
        file(REMOVE_RECURSE "${dir}")
    endif()
endforeach()

# Everything recorded is gone: start the next install with a clean record.
file(REMOVE "${manifest}" "${history}")
