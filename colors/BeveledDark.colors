#
# Dark scheme: the classic bevels on a dark neutral face. Bevel shades are computed by Beveled
# from the face, with a softer highlight than on light faces.
#
# No [Colors:Header] group on purpose: when it exists, KWin paints title bars with the Header
# colors instead of [WM], and apps fall back to the Window colors anyway.

[ColorEffects:Disabled]
Color=128,128,128
ColorAmount=0
ColorEffect=0
ContrastAmount=0.5
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

